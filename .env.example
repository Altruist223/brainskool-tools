# ─────────────────────────────────────────────────────────────
#  .env.example  —  Copy this as .env for local development.
#  On Netlify: set these in Site Settings > Environment Variables
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (local: mongodb://127.0.0.1:27017/brainskool)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brainskool?retryWrites=true&w=majority

# JWT signing secret — use a long, random string in production
JWT_SECRET=replace_with_a_strong_random_secret

# Admin password reset token — keep private!
ADMIN_RESET_SECRET=replace_with_a_strong_random_secret

# Not used on Netlify (functions have no persistent port), keep for local dev
PORT=3000
